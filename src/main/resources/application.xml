<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context-4.0.xsd">


    <!--    The first way to configure properties-->
    <!--    <bean class="org.springframework.context.support.PropertySourcesPlaceholderConfigurer">-->
    <!--        <property name="location" value="classpath:application.properties"/>-->
    <!--    </bean>-->

    <!--    The second way to configure properties (better)-->
    <!--    Add to the head: xmlns:context="http://www.springframework.org/schema/context"-->
    <context:property-placeholder location="classpath:application.properties"/>




    <!--    Create bean with constructor-->
    <bean id="repo1" name="r1, r2" class="spring.database.repository.UserRepository" init-method="init" destroy-method="destroy"> <!--  init-method="init" destroy-method="destroy": one of the ways to init/destroy beans-->
                                                                                                                                  <!--  in order the methods to work we need to call context.close() in the SpringRunner-->
            <constructor-arg name="userName" value="${db.username}" />  <!-- make use of properties-->
            <constructor-arg name="poolSize" value="${db.pollsize}" />  <!-- expression language-->
            <constructor-arg name="args" >
                    <list>
                        <value>1</value>
                        <value>2</value>
                        <value>3</value>  <!--  <ref>driver</ref> instead of <value>3</value> in order to use bean-->
                    </list>
            </constructor-arg>
            <constructor-arg name="properties" >
                <map>
                    <entry key="user" value="Alex" />
                    <entry key="address" value="München" />
                </map>
            </constructor-arg>
    </bean>

<!--    Create bean with setters-->
   <bean id="repo2" name="r3" class="spring.database.repository.UserRepository">
       <property name="userName" ref="driver" />  <!--    ref="driver" instead of value="user2" to make dependency injection possible-->
       <property name="properties" >
           <map>
               <entry key="user" value="#{driver.replace('a', 'b')}" /> <!-- spring language: you can write methods with it -->
                                                                        <!-- Is used to change something on the bean definition level -->
               <entry key="address" value-ref="driver" />  <!--    key-ref/value-ref="driver" instead of key/value="Berlin" if we want to use another bean -->
           </map>
       </property>
   </bean>

    <!--    Bean we use as reference in other beans-->
    <bean name="driver" class="java.lang.String">
        <constructor-arg value="PostgresDriver" />
    </bean>


    <!--    Task: create Bean UserService-->
    <!--    First we create bean UserDto-->
    <bean name="userDto" class="spring.dto.UserDto" scope="prototype"/>  <!--   scope="prototype" - new bean for each call-->

    <!--    Then we need a UserMapper bean-->
    <bean name="userMapper" class="spring.mapper.UserMapper">
        <constructor-arg ref="userDto"/>
<!--        <property name="userDto" ref="userDto" />   why doesn't it work like this? -->
    </bean>
    <!--    And now we can create a UserService bean-->
    <bean name="userService" class="spring.service.UserService">
         <constructor-arg ref="userMapper"/>
         <constructor-arg ref="r1"/>
<!--        <property name="userMapper" ref="userMapper" />-->
<!--        <property name="userRepository" ref="r1" />-->
    </bean>

</beans>